---
---

<footer>
    <div class="wrap">
        <div class="footer-bottom">
            <div></div>
            <img class="footer-olc-logo" src="/OLC_beige_vertical.jpg" alt="OLC Method">
            <div class="footer-powered">
                <span>Powered by</span>
                <a href="https://scale-rise.com" target="_blank" rel="noopener noreferrer" class="footer-powered-link">
                    <img src="/scalrise-logo-horizontal.jpg" alt="Scale-Rise">
                </a>
            </div>
        </div>
        <div class="footer-copy">&copy; 2026 OLC Method, all rights reserved</div>
    </div>
</footer>

<style>
    /* ─── FOOTER (WHITE + SAGE) ──────────────── */
    footer {
        background: var(--white);
        border-top: 1px solid var(--border);
        padding: 2.5rem 0 2rem;
    }
    .footer-nav {
        display: flex;
        justify-content: center;
        gap: 1.75rem;
        list-style: none;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }
    .footer-nav a {
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--sage);
        transition: color 0.18s;
    }
    .footer-nav a:hover { color: var(--text); }
    .footer-olc-logo { height: 128px; width: auto; display: block; margin: 0 auto; }
    .footer-copy { font-size: 12px; color: var(--text-muted); text-align: center; margin-top: 0.75rem; }
    .footer-bottom {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
    }
    .footer-bottom-left { }
    .footer-powered {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.3rem;
        justify-self: end;
    }
    .footer-powered span { font-size: 11px; color: var(--text-muted); letter-spacing: 0.06em; white-space: nowrap; }
    .footer-powered img { height: 60px; width: auto; opacity: 0.7; transition: opacity 0.2s; }
    .footer-powered-link:hover img { opacity: 1; }

    @media (max-width: 767px) {
        .footer-nav { gap: 1rem; }
    }
</style>
