---
---

<nav id="nav">
    <div class="nav-inner">
        <a href="/" class="nav-logo">
            <img src="/OLC_beige_horizontal.jpg" alt="OLC Method">
        </a>
        <ul class="nav-links">
            <li><a href="#method">Method</a></li>
            <li><a href="#why">Why OLC</a></li>
            <li><a href="#results">Results</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#tools">Tools</a></li>
            <li><a href="#faq">FAQ</a></li>
        </ul>
        <div class="nav-right">
            <a href="#audit-form" class="btn btn-filled">Get my free consultation</a>
            <button class="hamburger" id="hamburger" aria-label="Menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</nav>

<div class="mobile-menu" id="mobile-menu">
    <ul>
        <li><a href="#method" onclick="closeMobileMenu()">Method</a></li>
        <li><a href="#why" onclick="closeMobileMenu()">Why OLC</a></li>
        <li><a href="#results" onclick="closeMobileMenu()">Results</a></li>
        <li><a href="#services" onclick="closeMobileMenu()">Services</a></li>
        <li><a href="#tools" onclick="closeMobileMenu()">Tools</a></li>
        <li><a href="#faq" onclick="closeMobileMenu()">FAQ</a></li>
        <li><a href="#audit-form" onclick="closeMobileMenu()">Get my free consultation</a></li>
    </ul>
</div>

<script>
    const nav = document.getElementById('nav');
    addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 50));

    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('open');
        mobileMenu.classList.toggle('open');
    });
    function closeMobileMenu() {
        hamburger.classList.remove('open');
        mobileMenu.classList.remove('open');
    }
    // Expose globally for inline onclick handlers
    (window as any).closeMobileMenu = closeMobileMenu;
</script>

<style>
    /* ─── NAV ────────────────────────────────── */
    nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: var(--white);
        border-bottom: 1px solid var(--border);
    }
    nav.scrolled {
        box-shadow: 0 1px 20px rgba(15,21,16,0.05);
    }
    .nav-inner {
        max-width: 1280px; margin: 0 auto; padding: 0 2rem;
        height: 100px;
        display: flex; align-items: center;
    }
    .nav-logo img {
        height: 88px; width: auto;
        display: block;
        flex-shrink: 0;
    }
    @media (max-width: 767px) {
        .nav-logo img { height: 104px; }
        .nav-right { margin-left: auto; }
        .nav-right .btn { display: none; }
    }
    .nav-links {
        display: none;
        list-style: none;
        gap: 1.875rem;
        align-items: center;
        margin-left: auto;
        margin-right: 1.875rem;
    }
    @media (min-width: 768px) { .nav-links { display: flex; } }

    /* ─── HAMBURGER ──────────────────────────── */
    .hamburger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 36px; height: 36px;
        background: none; border: none;
        cursor: pointer; padding: 6px;
        border-radius: 6px;
    }
    .hamburger span {
        display: block; width: 100%; height: 1.5px;
        background: var(--sage);
        transition: transform 0.25s, opacity 0.25s;
        transform-origin: center;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
    @media (min-width: 768px) { .hamburger { display: none; } }

    .mobile-menu {
        display: none;
        position: fixed; top: 100px; left: 0; right: 0;
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 1.25rem 2.5rem 1.75rem;
        z-index: 99;
        box-shadow: 0 8px 24px rgba(15,21,16,0.08);
    }
    .mobile-menu.open { display: block; }
    .mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: 0; }
    .mobile-menu a {
        display: block;
        font-size: 15px; font-weight: 400;
        color: var(--text-dim);
        padding: 0.9rem 0;
        border-bottom: 1px solid var(--border);
        transition: color 0.15s;
    }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu a:hover { color: var(--sage); }
    @media (min-width: 768px) { .mobile-menu { display: none !important; } }

    .nav-links a {
        font-family: var(--font-b);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--sage);
        padding: 0.5rem 1.1rem;
        border-radius: 100px;
        border: 1px solid var(--sage);
        transition: background 0.15s, color 0.15s;
    }
    .nav-links a:hover { background: var(--sage); color: #fff; }
    .nav-right { display: flex; align-items: center; gap: 0.6rem; }

    @media (max-width: 420px) {
        nav { padding: 0 1.25rem; }
    }
</style>
