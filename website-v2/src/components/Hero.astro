---

<section id="hero">
    <div class="hero-inner">
        <div class="hero-eyebrow" id="hero-eyebrow">
            <div class="dot"></div>
            <span class="label">Performance-based sales &amp; marketing for real estate developers and hospitality brands &middot; Bali, Lombok, Southeast Asia</span>
        </div>
        <h1 class="hero-h1" id="hero-h1">
            Turnkey marketing strategy &amp;<br>
            sales cycles for real estate developers<br>
            <em>who want deals closed.</em>
        </h1>
        <p class="hero-strong fu d2">
            We design your value-driven offer, build your sales pipeline, and convert leads into buyers. No management fee. We only win when you do.
        </p>
        <div class="hero-ctas">
            <a href="#audit-form" class="btn btn-filled btn-throw">Book my meeting</a>
            <a href="#method" class="btn btn-ghost btn-throw" style="animation-delay:0.15s">See how it works</a>
            <a href="#results" class="btn btn-ghost btn-throw" style="animation-delay:0.3s">See our results</a>
            <a href="#market-makers" class="btn btn-ghost btn-throw" style="animation-delay:0.45s">For Market Makers</a>
        </div>
    </div>
</section>

<script>
    // H1 italic: "who want deals closed." fades in word by word
    const heroEm = document.querySelector('#hero-h1 em');
    if (heroEm) {
        heroEm.innerHTML = heroEm.textContent.trim().split(' ')
            .map(w => `<span class="hw">${w}</span>`).join(' ');

        new IntersectionObserver(entries => {
            entries.forEach(e => {
                const words = e.target.querySelectorAll('.hw');
                if (e.isIntersecting) {
                    words.forEach((w, i) => {
                        (w as HTMLElement).style.animationDelay = `${i * 0.22}s`;
                        w.classList.add('show');
                    });
                } else {
                    words.forEach(w => w.classList.remove('show'));
                }
            });
        }, { threshold: 0.2 }).observe(document.getElementById('hero-h1'));
    }
</script>

<style>
    /* ─── HERO ───────────────────────────────── */
    #hero {
        background: var(--white);
        padding: 160px 0 100px;
    }
    .hero-inner { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
    .hero-eyebrow {
        display: inline-flex; align-items: flex-start; gap: 0.6rem;
        background: var(--sage-pale);
        padding: 0.4rem 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        max-width: 700px;
    }
    .hero-eyebrow .dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--sage); flex-shrink: 0;
        margin-top: 4px;
    }
    .hero-eyebrow .label { line-height: 1.6; }
    .hero-h1 {
        font-size: clamp(34px, 4vw, 58px);
        font-weight: 300;
        letter-spacing: -0.02em;
        line-height: 1.1;
        max-width: 820px;
        margin-bottom: 1.5rem;
    }
    .hero-h1 em { font-style: italic; color: var(--sage); }
    .hero-strong {
        font-family: var(--font-b);
        font-size: 16px;
        font-weight: 500;
        color: var(--text);
        max-width: 600px;
        margin-bottom: 1rem;
        line-height: 1.7;
    }
    .hero-sub {
        font-size: 15px;
        color: var(--text-dim);
        max-width: 600px;
        margin-bottom: 2.5rem;
        line-height: 1.85;
    }
    .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem;
    }

    /* ─── ANIMATIONS ─────────────────────────── */
    .fu { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .fu.on { opacity: 1; transform: none; }
    .d1 { transition-delay: 0.08s; }
    .d2 { transition-delay: 0.16s; }
    .d3 { transition-delay: 0.24s; }

    /* ─── H1 ITALIC WORD FADE ────────────────────── */
    @keyframes word-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    .hw { opacity: 0; }
    .hw.show { animation: word-fade 0.3s ease both; }

    /* ─── BUTTON THROW-IN (scroll-triggered) ──── */
    @keyframes throw-in {
        0%   { opacity: 0; transform: translateY(-28px) rotate(-2deg) scale(0.92); }
        60%  { opacity: 1; transform: translateY(5px) rotate(0.5deg) scale(1.02); }
        80%  { transform: translateY(-3px) rotate(-0.3deg) scale(0.99); }
        100% { opacity: 1; transform: translateY(0) rotate(0) scale(1); }
    }
    .btn-throw { opacity: 0; }
    .btn-throw.on { animation: throw-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both; }

    @media (max-width: 720px) {
        #hero { padding: 110px 0 70px; }
    }
    @media (max-width: 420px) {
        .hero-inner { padding: 0 1.25rem; }
    }
</style>
