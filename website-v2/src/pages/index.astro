---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import AuditForm from '../components/AuditForm.astro';
import ProofBar from '../components/ProofBar.astro';
import Problem from '../components/Problem.astro';
import Method from '../components/Method.astro';
import Why from '../components/Why.astro';
import Results from '../components/Results.astro';
import Services from '../components/Services.astro';
import Tools from '../components/Tools.astro';
import FAQ from '../components/FAQ.astro';
import MarketMakers from '../components/MarketMakers.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Nav />
  <Hero />

  <AuditForm />
  <ProofBar />
  <Problem />

  <Method />
  <Why />
  <Results />

  <Services />
  <Tools />
  <FAQ />

  <MarketMakers />
  <CTA />

  <Footer />
</BaseLayout>

<script>
  // Scroll-triggered animation observer (shared across all sections)
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.target.classList.contains('fu')) {
        if (e.isIntersecting) { e.target.classList.add('on'); obs.unobserve(e.target); }
      } else {
        if (e.isIntersecting) {
          e.target.classList.add('on');
        } else {
          e.target.classList.remove('on');
        }
      }
    }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.fu, .btn-throw, .card-throw').forEach(el => obs.observe(el));
</script>
