---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Real Estate Sales and Marketing for Developers and Hospitality | OLC Method",
  description = "OLC Method designs your Value Driven Offer, builds your sales engine, and closes buyers for you. No management fee. We both earn when we sell. Bali, Lombok, Southeast Asia.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/jpeg" href="/OLC_beige_vertical.jpg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://olcmethod.com" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://olcmethod.com" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Organization","name":"OLC Method","url":"https://olcmethod.com","description":"Performance-based sales and marketing partnership for real estate developers and hospitality brands. OLC Method designs your offer, generates qualified buyers, and closes deals personally. No management fee.","email":"hello@olcmethod.com","areaServed":["Bali","Lombok","Indonesia"],"serviceType":"Performance-based real estate sales and marketing partnership"})} />

    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is OLC Method?","acceptedAnswer":{"@type":"Answer","text":"OLC Method is a marketing & sales system we build and run for real estate developers and hospitality leaders. OLC stands for Offer, Leads, Close. We design the offer, generate qualified buyers, and close deals personally. You run your project, we run your sales engine."}},{"@type":"Question","name":"How does OLC Method get paid?","acceptedAnswer":{"@type":"Answer","text":"The partnership starts with a one-time onboarding fee that funds the full strategy build: offer design, marketing documentation, and sales playbook. After that, no management fee, no invoices for work in progress. There is a small monthly running cost (~$800) for the campaign tools that keep your pipeline running. You cover the marketing budget directly. We earn a commission on each unit sold, no management fee. We both earn when we sell."}},{"@type":"Question","name":"What is the monthly campaign infrastructure cost?","acceptedAnswer":{"@type":"Answer","text":"There is a small monthly running cost (~$800) for the campaign tools that keep your pipeline running, that is it. We pass it through at cost, no markup, no management fee. You can see exactly what it covers."}},{"@type":"Question","name":"What type of projects do we work with?","acceptedAnswer":{"@type":"Answer","text":"Residential, commercial, or mixed-use. What matters is whether the project has something real behind it: a location, a concept, a design that gives a serious buyer a reason to pay attention. We don't take on every project. Trust comes first."}},{"@type":"Question","name":"How is OLC Method different from a real estate agent?","acceptedAnswer":{"@type":"Answer","text":"Agents list your property alongside dozens of others and wait for buyers. We build a sales system dedicated entirely to your project and close deals personally. We do not list properties."}},{"@type":"Question","name":"How is OLC Method different from a marketing agency?","acceptedAnswer":{"@type":"Answer","text":"An agency invoices you whether anything sells. We only get paid when you close. But the bigger difference is how we work: we're not a vendor filling a spreadsheet. We get into the project with you, help design the offer so it converts, and close the deals ourselves."}},{"@type":"Question","name":"Which markets does OLC Method operate in?","acceptedAnswer":{"@type":"Answer","text":"Bali (Seminyak, Canggu, Uluwatu, Pererenan, Nusa Dua), Lombok, and the Nusa islands."}},{"@type":"Question","name":"What does performance-based actually mean?","acceptedAnswer":{"@type":"Answer","text":"It means we get paid when we sell your offer. No management fee, no invoices for work in progress. If the project doesn't close deals, we don't earn. That's why we're selective. We don't take on a project we don't think we can sell."}},{"@type":"Question","name":"How do I get started?","acceptedAnswer":{"@type":"Answer","text":"Book your meeting through our website or email us at hello@olcmethod.com. We schedule a 30-minute call, understand your project, and tell you directly whether it is a fit. No pitch deck."}}]})} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="splash" aria-hidden="true">
      <div class="splash-wrap">
        <svg class="splash-mark" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Outer ring: draws clockwise from 12 o'clock -->
          <circle class="sm-ring" cx="50" cy="50" r="44" stroke="#4F6352" stroke-width="1.4" pathLength="1" transform="rotate(-90 50 50)"/>
          <!-- Inner C arc: r=35 (sits close to outer ring), gap from 12 to 3.
               Draws clockwise from 3 o'clock (85,50) through 6+9 to 12 (50,15). -->
          <path class="sm-arc" d="M85,50 A35,35 0 1,1 50,15" stroke="#4F6352" stroke-width="1.4" stroke-linecap="round" fill="none" pathLength="1"/>
          <!-- Minute hand: center to 12 o'clock endpoint of C arc -->
          <line class="sm-min" x1="50" y1="50" x2="50" y2="15" stroke="#4F6352" stroke-width="1.4" stroke-linecap="round" pathLength="1"/>
          <!-- Hour hand: center to 3 o'clock endpoint of C arc -->
          <line class="sm-hour" x1="50" y1="50" x2="85" y2="50" stroke="#4F6352" stroke-width="1.4" stroke-linecap="round" pathLength="1"/>
          <!-- Center hub -->
          <circle class="sm-hub" cx="50" cy="50" r="2.5" fill="#4F6352"/>
        </svg>
        <div class="splash-word">
          <div class="splash-rules"><span></span><span></span></div>
          <p class="splash-meth">METHOD</p>
          <p class="splash-olc">OFFER · LEADS · CLOSE</p>
        </div>
      </div>
    </div>

    <script>
      (function () {
        var splash = document.getElementById('splash');
        if (!splash) return;
        document.body.classList.add('splash-open');
        setTimeout(function () {
          splash.classList.add('splash-out');
          document.body.classList.remove('splash-open');
          setTimeout(function () { splash.remove(); }, 580);
        }, 2050);
      })();
    </script>

    <slot />
  </body>
</html>

<style is:global>
  /* ─── TOKENS ─────────────────────────────── */
  :root {
    --white:      #F9F8F4;
    --off-white:  #EFEDE7;
    --card:       #FFFFFF;
    --sage:       #4F6352;
    --sage-lt:    #6B8470;
    --sage-pale:  #EDF1EE;
    --dark:       #0D100C;
    --text:       #0F1510;
    --text-dim:   #3D4D40;
    --text-muted: #9BA89E;
    --border:     rgba(79,99,82,0.13);
    --shadow:     0 2px 16px rgba(15,21,16,0.06);
    --shadow-md:  0 4px 24px rgba(15,21,16,0.09);
    --font-d: 'Cormorant', Georgia, serif;
    --font-b: 'DM Sans', system-ui, sans-serif;
  }

  /* ─── RESET ──────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; font-size: 16px; }
  body {
    background: var(--white);
    color: var(--text);
    font-family: var(--font-b);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* ─── TYPOGRAPHY ─────────────────────────── */
  .label {
    font-family: var(--font-b);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
  }
  h1, h2 { font-family: var(--font-d); font-weight: 400; line-height: 1.05; }
  h3 { font-family: var(--font-b); font-weight: 500; line-height: 1.3; }
  p { color: var(--text-dim); line-height: 1.8; font-size: 16px; }

  /* ─── LAYOUT ─────────────────────────────── */
  .wrap        { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .wrap--tight { max-width: 840px;  margin: 0 auto; padding: 0 2rem; }
  section      { padding: 80px 0; }

  /* ─── BUTTONS ────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-b);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.02em;
    padding: 0.65rem 1.3rem;
    border-radius: 6px;
    border: 1px solid var(--sage);
    color: var(--sage);
    background: transparent;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
    white-space: nowrap;
  }
  .btn:hover { background: var(--sage); color: #fff; }
  .btn-filled { background: var(--sage); color: #fff; }
  .btn-filled:hover { background: var(--sage-lt); border-color: var(--sage-lt); }
  .btn-ghost { border-color: var(--border); color: var(--text-dim); }
  .btn-ghost:hover { border-color: var(--sage); color: var(--sage); background: transparent; }
  .btn-sage-filled { background: #FFFFFF; color: var(--sage); border-color: #FFFFFF; }
  .btn-sage-filled:hover { background: var(--sage-pale); border-color: var(--sage-pale); }
  .btn-sage-outline { border-color: rgba(255,255,255,0.35); color: rgba(255,255,255,0.8); }
  .btn-sage-outline:hover { border-color: #fff; color: #fff; background: transparent; }

  .wa-icon { width: 14px; height: 14px; flex-shrink: 0; }

  /* ─── SECTION HEADER ─────────────────────── */
  .sec-head { margin-bottom: 3.5rem; }
  .sec-head .label { display: block; margin-bottom: 0.875rem; }
  .sec-title {
    font-size: clamp(34px, 4.2vw, 56px);
    font-weight: 300;
    letter-spacing: -0.01em;
    max-width: 640px;
    color: var(--text);
    line-height: 1.08;
  }
  .sec-title em { font-style: italic; color: var(--sage); }
  .slogan-quote {
    font-family: var(--font-d);
    font-size: clamp(2rem, 5vw, 4rem);
    font-style: italic;
    font-weight: 300;
    color: var(--sage);
    line-height: 1.15;
  }

  /* ─── PROOF BAR ──────────────────────────── */
  #proof-bar {
    background: var(--sage-pale);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
    overflow: hidden;
  }
  .proof-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: ticker 40s linear infinite;
  }
  .proof-track:hover { animation-play-state: paused; }
  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .proof-item {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    white-space: nowrap;
    min-width: 26vw;
    text-align: center;
    padding: 0 1.5rem;
  }
  .proof-item strong { color: var(--sage); font-weight: 700; }
  .proof-sep {
    color: var(--text-muted);
    font-size: 12px;
    flex-shrink: 0;
    width: 4vw;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ─── PROBLEM ────────────────────────────── */
  #problem { background: var(--white); }
  .prob-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .prob-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2rem 2.25rem;
    box-shadow: var(--shadow);
    border-left: 3px solid var(--sage);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .prob-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .prob-num {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 1.25rem;
  }
  .prob-title {
    font-size: 16px; font-weight: 500;
    color: var(--text); margin-bottom: 0.75rem; line-height: 1.4;
  }
  .prob-desc { font-size: 14px; line-height: 1.8; }

  /* ─── METHOD ─────────────────────────────── */
  #method { background: var(--off-white); }
  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3.5rem;
  }
  .m-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2.25rem;
    box-shadow: var(--shadow);
  }
  .m-letter {
    font-family: var(--font-d);
    font-size: clamp(64px, 8vw, 100px);
    font-weight: 600;
    color: var(--sage);
    line-height: 0.9;
    margin-bottom: 1.25rem;
    opacity: 0.35;
  }
  .m-title { font-size: 17px; font-weight: 500; color: var(--text); margin-bottom: 0.75rem; }
  .m-desc { font-size: 14px; }

  /* ─── WHY ────────────────────────────────── */
  #why { background: var(--white); }
  .why-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
    margin-top: 3.5rem;
  }
  .why-list { list-style: none; }
  .why-item {
    display: flex; gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .why-list .why-item:first-child { border-top: 1px solid var(--border); }
  .why-check {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--sage-pale);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 2px;
  }
  .why-check svg { width: 10px; height: 10px; color: var(--sage); }
  .why-h { font-size: 15px; font-weight: 500; color: var(--text); margin-bottom: 0.25rem; }
  .why-p { font-size: 14px; }
  .why-pull {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2.5rem;
    position: sticky;
    top: 100px;
  }
  .why-pull blockquote {
    font-family: var(--font-d);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    color: var(--text);
    margin-bottom: 1.5rem;
  }
  .why-pull cite {
    font-size: 12px; font-weight: 500;
    letter-spacing: 0.06em; color: var(--sage); font-style: normal;
  }

  /* ─── RESULTS ────────────────────────────── */
  #results { background: var(--off-white); }
  .results-row { display: flex; align-items: center; }
  .results-row .sec-head { flex: 1; margin-bottom: 0; }
  .results-card-col { flex: 1; display: flex; justify-content: center; }
  .result-card {
    width: 340px;
    background: var(--card);
    border: 1px dashed rgba(79,99,82,0.3);
    border-radius: 10px;
    padding: 2rem 2.5rem;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .result-card .label { margin-bottom: 1rem; }
  .result-client {
    font-family: var(--font-d);
    font-size: 1.5rem; font-weight: 400;
    color: var(--text); margin-bottom: 0.75rem;
  }
  .result-card p { font-size: 14px; }

  /* ─── SERVICES & TOOLS ──────────────────── */
  #services { background: var(--white); }
  #tools { background: var(--off-white); }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3.5rem;
  }
  .svc-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2rem 2.25rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .svc-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .svc-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }
  .svc-icon { font-size: 1.2rem; line-height: 1; }
  .svc-arrow { color: var(--sage); font-size: 1rem; opacity: 0.45; }
  .svc-title {
    font-family: var(--font-b);
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }
  .svc-sub {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.875rem;
  }
  .svc-desc {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.8;
    flex: 1;
  }
  .svc-proof {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--sage);
    font-weight: 500;
  }
  .tool-featured {
    background: var(--sage);
    border-color: var(--sage);
  }
  .tool-featured .svc-title { color: #fff; }
  .tool-featured .svc-sub { color: rgba(255,255,255,0.55); }
  .tool-featured .svc-desc { color: rgba(255,255,255,0.75); }
  .tool-title-link { color: inherit; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.35); transition: border-color 0.18s; }
  .tool-title-link:hover { border-bottom-color: rgba(255,255,255,0.9); }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .svc-grid { grid-template-columns: 1fr; } }

  /* ─── FAQ ────────────────────────────────── */
  #faq { background: var(--white); }
  .faq-list { margin-top: 3.5rem; }
  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-q {
    width: 100%; background: none; border: none;
    padding: 1.5rem 0;
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer; color: var(--text);
    font-family: var(--font-b); font-size: 15px; font-weight: 400;
    text-align: left; gap: 2rem;
    transition: color 0.18s;
  }
  .faq-q:hover { color: var(--sage); }
  .faq-plus {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--sage-pale);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: var(--sage);
    font-size: 14px; font-weight: 400;
    transition: transform 0.28s cubic-bezier(0.4,0,0.2,1), background 0.18s;
    line-height: 1;
  }
  .faq-item.open .faq-plus { transform: rotate(45deg); background: var(--sage); color: #fff; }
  .faq-body { max-height: 0; overflow: hidden; transition: max-height 0.38s ease; }
  .faq-item.open .faq-body { max-height: 500px; }
  .faq-body-inner {
    padding-bottom: 1.5rem; font-size: 14px;
    line-height: 1.85; color: var(--text-dim); max-width: 680px;
  }

  /* ─── MARKET MAKERS ──────────────────────── */
  #market-makers { background: var(--off-white); }
  .mm-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3.5rem;
  }
  .mm-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2rem 2.25rem;
    box-shadow: var(--shadow);
  }
  .mm-tag {
    display: inline-block;
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--sage);
    background: var(--sage-pale);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1.25rem;
  }
  .mm-title { font-size: 16px; font-weight: 500; color: var(--text); margin-bottom: 0.6rem; line-height: 1.4; }
  .mm-desc { font-size: 14px; line-height: 1.8; }

  /* ─── AUDIT FORM ─────────────────────────── */
  #audit-form { background: var(--sage-pale); border-bottom: 1px solid var(--border); padding: 70px 0; }
  .audit-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .audit-quote { display: flex; justify-content: center; }
  .form-head { margin-bottom: 2rem; }
  .capture-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .form-input {
    font-family: var(--font-b);
    font-size: 14px;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    color: var(--text);
    outline: none;
    transition: border-color 0.18s;
    width: 100%;
  }
  .form-input:focus { border-color: var(--sage); }
  .form-input::placeholder { color: var(--text-muted); }
  .form-submit { align-self: flex-start; padding: 0.75rem 1.75rem; margin-top: 0.75rem; }

  /* ─── SPLASH ─────────────────────────────── */
  body.splash-open { overflow: hidden; }

  #splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.55s ease;
  }
  #splash.splash-out { opacity: 0; pointer-events: none; }

  .splash-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }
  .splash-mark { width: 96px; height: 96px; }

  /* Stroke draw */
  .sm-ring, .sm-arc, .sm-min, .sm-hour {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .sm-hub { opacity: 0; }

  @keyframes olc-draw { to { stroke-dashoffset: 0; } }
  @keyframes olc-pop  { to { opacity: 1; } }
  @keyframes olc-word {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: none; }
  }

  .sm-ring { animation: olc-draw 0.65s cubic-bezier(0.4,0,0.2,1) 0.05s both; }
