---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Real Estate Sales and Marketing for Developers and Hospitality | OLC Method",
  description = "OLC Method designs your Value Driven Offer, builds your sales engine, and closes buyers for you. No management fee. We both earn when we sell. Bali, Lombok, Southeast Asia.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://olcmethod.com" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://olcmethod.com" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Organization","name":"OLC Method","url":"https://olcmethod.com","description":"Performance-based sales and marketing partnership for real estate developers and hospitality brands. OLC Method designs your offer, generates qualified buyers, and closes deals personally. No management fee.","email":"hello@olcmethod.com","areaServed":["Bali","Lombok","Indonesia"],"serviceType":"Performance-based real estate sales and marketing partnership"})} />

    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is OLC Method?","acceptedAnswer":{"@type":"Answer","text":"OLC Method is a marketing & sales system we build and run for real estate developers and hospitality leaders. OLC stands for Offer, Leads, Close. We design the offer, generate qualified buyers, and close deals personally. You run your project, we run your sales engine."}},{"@type":"Question","name":"How does OLC Method get paid?","acceptedAnswer":{"@type":"Answer","text":"The partnership starts with a one-time onboarding fee that funds the full strategy build: offer design, marketing documentation, and sales playbook. After that, no management fee, no invoices for work in progress. There is a small monthly running cost (~$500) for the campaign tools that keep your pipeline running. You cover the marketing budget directly. We earn a commission on each unit sold, no management fee. We both earn when we sell."}},{"@type":"Question","name":"What is the monthly campaign infrastructure cost?","acceptedAnswer":{"@type":"Answer","text":"There is a small monthly running cost (~$800) for the campaign tools that keep your pipeline running, that is it. We pass it through at cost, no markup, no management fee. You can see exactly what it covers."}},{"@type":"Question","name":"What type of projects do we work with?","acceptedAnswer":{"@type":"Answer","text":"Residential, commercial, or mixed-use. What matters is whether the project has something real behind it: a location, a concept, a design that gives a serious buyer a reason to pay attention. We don't take on every project. Trust comes first."}},{"@type":"Question","name":"How is OLC Method different from a real estate agent?","acceptedAnswer":{"@type":"Answer","text":"Agents list your property alongside dozens of others and wait for buyers. We build a sales system dedicated entirely to your project and close deals personally. We do not list properties."}},{"@type":"Question","name":"How is OLC Method different from a marketing agency?","acceptedAnswer":{"@type":"Answer","text":"An agency invoices you whether anything sells. We only get paid when you close. But the bigger difference is how we work: we're not a vendor filling a spreadsheet. We get into the project with you, help design the offer so it converts, and close the deals ourselves."}},{"@type":"Question","name":"Which markets does OLC Method operate in?","acceptedAnswer":{"@type":"Answer","text":"Bali (Seminyak, Canggu, Uluwatu, Pererenan, Nusa Dua), Lombok, and the Nusa islands."}},{"@type":"Question","name":"What does performance-based actually mean?","acceptedAnswer":{"@type":"Answer","text":"It means we get paid when we sell your offer. No management fee, no invoices for work in progress. If the project doesn't close deals, we don't earn. That's why we're selective. We don't take on a project we don't think we can sell."}},{"@type":"Question","name":"How do I get started?","acceptedAnswer":{"@type":"Answer","text":"Book your meeting through our website or email us at hello@olcmethod.com. We schedule a 30-minute call, understand your project, and tell you directly whether it is a fit. No pitch deck."}}]})} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ─── TOKENS ─────────────────────────────── */
  :root {
    --white:      #F9F8F4;
    --off-white:  #EFEDE7;
    --card:       #FFFFFF;
    --sage:       #4F6352;
    --sage-lt:    #6B8470;
    --sage-pale:  #EDF1EE;
    --dark:       #0D100C;
    --text:       #0F1510;
    --text-dim:   #3D4D40;
    --text-muted: #9BA89E;
    --border:     rgba(79,99,82,0.13);
    --shadow:     0 2px 16px rgba(15,21,16,0.06);
    --shadow-md:  0 4px 24px rgba(15,21,16,0.09);
    --font-d: 'Cormorant', Georgia, serif;
    --font-b: 'DM Sans', system-ui, sans-serif;
  }

  /* ─── RESET ──────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; font-size: 16px; }
  body {
    background: var(--white);
    color: var(--text);
    font-family: var(--font-b);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* ─── TYPOGRAPHY ─────────────────────────── */
  .label {
    font-family: var(--font-b);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
  }
  h1, h2 { font-family: var(--font-d); font-weight: 400; line-height: 1.05; }
  h3 { font-family: var(--font-b); font-weight: 500; line-height: 1.3; }
  p { color: var(--text-dim); line-height: 1.8; font-size: 16px; }

  /* ─── LAYOUT ─────────────────────────────── */
  .wrap        { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .wrap--tight { max-width: 840px;  margin: 0 auto; padding: 0 2rem; }
  section      { padding: 80px 0; }

  /* ─── BUTTONS ────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-b);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.02em;
    padding: 0.65rem 1.3rem;
    border-radius: 6px;
    border: 1px solid var(--sage);
    color: var(--sage);
    background: transparent;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
    white-space: nowrap;
  }
  .btn:hover { background: var(--sage); color: #fff; }
  .btn-filled { background: var(--sage); color: #fff; }
  .btn-filled:hover { background: var(--sage-lt); border-color: var(--sage-lt); }
  .btn-ghost { border-color: var(--border); color: var(--text-dim); }
  .btn-ghost:hover { border-color: var(--sage); color: var(--sage); background: transparent; }
  .btn-sage-filled { background: #FFFFFF; color: var(--sage); border-color: #FFFFFF; }
  .btn-sage-filled:hover { background: var(--sage-pale); border-color: var(--sage-pale); }
  .btn-sage-outline { border-color: rgba(255,255,255,0.35); color: rgba(255,255,255,0.8); }
  .btn-sage-outline:hover { border-color: #fff; color: #fff; background: transparent; }

  .wa-icon { width: 14px; height: 14px; flex-shrink: 0; }
</style>
